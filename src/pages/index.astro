<script>
  // La barre d'inscription n'apparaît qu'une fois le hero dépassé, et
  // disparaît sur la section tarif où le bouton est déjà présent.
  const bar = document.getElementById('sticky-bar');
  const hero = document.querySelector('.hero');
  // Les zones où un bouton d'inscription est déjà visible : inutile d'y
  // superposer la barre.
  const zonesCta = [
    document.getElementById('tarif'),
    document.querySelector('.final-cta'),
  ].filter(Boolean);

  if (bar && hero) {
    bar.hidden = false;
    let heroPassed = false;
    const ctaVisibles = new Set();

    const sync = () => {
      bar.dataset.visible = String(heroPassed && ctaVisibles.size === 0);
    };

    new IntersectionObserver(
      ([entry]) => {
        heroPassed = !entry.isIntersecting;
        sync();
      },
      { rootMargin: '0px' }
    ).observe(hero);

    const zoneObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) ctaVisibles.add(entry.target);
          else ctaVisibles.delete(entry.target);
        });
        sync();
      },
      { threshold: 0.15 }
    );
    zonesCta.forEach((zone) => zoneObserver.observe(zone));
  }
</script>
