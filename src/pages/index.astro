---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Doodle from '../components/Doodle.astro';
import portrait from '../assets/nicolas-portrait.png';
import {
  chiffres,
  clients,
  cohorte,
  competences,
  credentials,
  faq,
  formateur,
  formulePrincipale,
  formules,
  frictions,
  laboratoires,
  liens,
  lienAchat,
  lives,
  modules,
  offre,
  pourQui,
  prixRemise,
  promo,
  promoSuivante,
  temoignages,
} from '../data/academie';

const title =
  'Académie des Décoincés du Crayon — Formation facilitation & facilitation graphique | Cohorte 2026-2027';
const description =
  "Formation en ligne à la facilitation et à la facilitation graphique pour consultants, formateurs et coachs. 11 modules, 9 laboratoires, 7 lives avec Nicolas Verdot. Accès à vie. Cohorte 2026-2027.";

const eur = new Intl.NumberFormat('fr-FR');
const fmt = (n: number) => eur.format(n);

// Formule mise en avant dans le hero, la barre collante et le CTA final.
const principale = formulePrincipale;
const lienPrincipal = lienAchat(principale);
const prixPrincipal = prixRemise(principale.prixComptant);
const mensuelPrincipal = prixRemise(principale.prixMensuel);

// « Sans frais » ne s'affiche que si l'échelonnement ne coûte réellement rien
// de plus — la mention se met à jour toute seule si un tarif change.
const sansFrais = (f: typeof principale) =>
  prixRemise(f.prixMensuel) * f.nbMensualites === prixRemise(f.prixComptant);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: 'Académie des Décoincés du Crayon',
    description:
      "Parcours en ligne à la facilitation et à la facilitation graphique : cadrer une demande, concevoir une session, tenir un groupe et faire atterrir un plan d'action. Destiné aux consultants, formateurs, coachs et facilitateurs.",
    url: 'https://academie.decoincesducrayon.com/',
    inLanguage: 'fr',
    provider: {
      '@type': 'Organization',
      name: 'Décoincés du Crayon',
      url: 'https://www.decoincesducrayon.com',
    },
    offers: formules.map((f) => ({
      '@type': 'Offer',
      name: f.nom,
      price: prixRemise(f.prixComptant),
      priceCurrency: offre.prixDevise,
      category: 'Paid',
      url: lienAchat(f),
      availability: 'https://schema.org/InStock',
      ...(promo.actif ? { priceValidUntil: promo.dateFin } : {}),
      priceSpecification: {
        '@type': 'PriceSpecification',
        price: prixRemise(f.prixComptant),
        priceCurrency: offre.prixDevise,
        valueAddedTaxIncluded: true,
      },
    })),
    hasCourseInstance: {
      '@type': 'CourseInstance',
      courseMode: 'online',
      courseWorkload: 'PT1H30M',
      startDate: cohorte.debut,
      endDate: cohorte.fin,
      instructor: {
        '@type': 'Person',
        name: formateur.nom,
        jobTitle: formateur.role,
      },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.reponse },
    })),
  },
];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  {
    promo && (
      <aside class="promo-bar">
        <div class="container promo-inner">
          <p>
            <strong>
              {promo.libelle} : −{promo.pourcentage}% jusqu'au{' '}
              {promo.jusquAuLisible}</strong>{promoSuivante
              ? `, puis −${promoSuivante.pourcentage}% jusqu'au ${promoSuivante.jusquAuLisible}.`
              : ', dernier palier avant le tarif plein.'}
            <span class="promo-aside">
              {' '}La remise s'applique automatiquement au paiement.
            </span>
          </p>
        </div>
      </aside>
    )
  }

  <header class="masthead">
    <div class="container masthead-inner">
      <a href="/" class="brand" aria-label="Académie des Décoincés du Crayon, accueil">
        <picture>
          <source
            srcset="/img/logo-decoinces-du-crayon-dark.png"
            media="(prefers-color-scheme: dark)"
          />
          <img
            src="/img/logo-decoinces-du-crayon.png"
            alt="Décoincés du Crayon"
            width="1151"
            height="200"
            class="brand-logo"
          />
        </picture>
        <span class="brand-sub">Académie</span>
      </a>
      <a class="masthead-cta" href={lienPrincipal}>S'inscrire</a>
    </div>
  </header>

  <main id="contenu">
    <!-- ================= HERO ================= -->
    <section class="hero">
      <div class="container hero-inner">
        <p class="hero-badge">{cohorte.label} · Inscriptions ouvertes</p>
        <h1>
          Académie des Décoincés du Crayon : la formation qui relie
          <span class="hl">facilitation</span> et
          <span class="hl">facilitation graphique</span>
        </h1>
        <p class="hero-lead">
          Pour les consultants, formateurs, coachs et facilitateurs qui savent
          déjà donner à voir — ou qui veulent apprendre — mais à qui il manque
          le processus&nbsp;: cadrer une demande, concevoir la session, tenir le
          groupe, et transformer un mur d'idées en décisions qui tiennent.
        </p>

        <div class="hero-cta">
          <a class="btn btn--primary" href={lienPrincipal}>
            Rejoindre la cohorte {cohorte.annees}
          </a>
          <p class="hero-price">
            À partir de{' '}
            {promo && (
              <s class="hero-price-was">{fmt(principale.prixComptant)} €</s>
            )}
            <strong>{fmt(prixPrincipal)} € {offre.mentionTva}</strong> ou
            {principale.nbMensualites} × {fmt(mensuelPrincipal)} €
            {offre.mentionTva}
          </p>
        </div>

        <ul class="hero-proof">
          <li>Accès à vie aux contenus</li>
          <li>7 lives en direct avec Nicolas</li>
          <li>Une communauté qui accumule les promotions</li>
        </ul>

        <div class="hero-scene">
          <Doodle name="scene" />
        </div>

        <p class="hero-authority">
          Animée par <strong>Nicolas Verdot</strong>, fondateur du Sommet des
          Décoincés du Crayon, coach certifié et ambassadeur Neuland.
        </p>
      </div>
    </section>

    <!-- ================= CHIFFRES ================= -->
    <section class="section section--tight numbers" aria-label="Le parcours en chiffres">
      <div class="container">
        <ul class="numbers-grid">
          {
            chiffres.map((c) => (
              <li>
                <span class="numbers-value">{c.valeur}</span>
                <span class="numbers-label">{c.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ================= FRICTIONS ================= -->
    <section class="section" id="te-reconnais-tu">
      <div class="container">
        <p class="eyebrow">Te reconnais-tu ?</p>
        <h2>Le dessin ne suffit pas à faire décider un groupe</h2>
        <p class="lead">
          La plupart des personnes qui rejoignent l'Académie ne manquent pas de
          talent. Elles manquent d'un processus. Voici ce qu'elles décrivent
          avant de commencer.
        </p>
        <div class="grid-3 friction-grid">
          {
            frictions.map((f) => (
              <article class="card friction-card">
                <h3>{f.titre}</h3>
                <p>{f.texte}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= COMPÉTENCES ================= -->
    <section class="section section--alt" id="competences">
      <div class="container">
        <p class="eyebrow">Ce que tu sauras faire</p>
        <h2>Six compétences, prises dans l'ordre où tu les utiliseras</h2>
        <p class="lead">
          L'Académie suit le déroulé réel d'une mission, du premier appel du
          client jusqu'à la relecture de ta propre animation.
        </p>
        <div class="grid-3 skill-grid">
          {
            competences.map((c, i) => (
              <article class="skill-card">
                <div class="skill-doodle">
                  <Doodle name={c.doodle} />
                </div>
                <span class="skill-num">{String(i + 1).padStart(2, '0')}</span>
                <h3>{c.titre}</h3>
                <p>{c.texte}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= POUR QUI ================= -->
    <section class="section" id="pour-qui">
      <div class="container">
        <p class="eyebrow">Public</p>
        <h2>Pour qui c'est fait — et pour qui ça ne l'est pas</h2>
        <div class="grid-2 fit-grid">
          <div class="card fit-card fit-card--yes">
            <h3>C'est pour toi si…</h3>
            <ul>{pourQui.oui.map((t) => <li>{t}</li>)}</ul>
          </div>
          <div class="card fit-card fit-card--no">
            <h3>Passe ton chemin si…</h3>
            <ul>{pourQui.non.map((t) => <li>{t}</li>)}</ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= PLAN DE VOL ================= -->
    <section class="section section--dark" id="plan-de-vol">
      <div class="container">
        <p class="eyebrow">Plan de vol</p>
        <h2>Tu avances à ton rythme, on se retrouve une fois par mois</h2>
        <div class="grid-2 flight-grid">
          <div class="flight-text">
            <p class="lead">
              Tous les modules sont ouverts dès ton inscription : tu n'attends
              pas qu'un contenu se déverrouille. Les lives, eux, rythment la
              saison de septembre à mars et servent à débloquer ce sur quoi tu
              butes réellement.
            </p>
            <ul class="flight-points">
              <li><strong>Accès immédiat</strong> à l'ensemble des modules et des laboratoires.</li>
              <li><strong>Mises à jour incluses</strong> à vie, y compris les contenus ajoutés après ta cohorte.</li>
              <li><strong>Replays systématiques</strong> si tu ne peux pas assister à un live.</li>
            </ul>
          </div>
          <div class="calendar">
            <h3>Les 7 lives · 18h30, heure de Paris</h3>
            <ol class="calendar-list">
              {
                lives.map((l) => (
                  <li>
                    <time datetime={l.date}>{l.libelle}</time>
                    {l.note && <span class="calendar-note">{l.note}</span>}
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= MODULES ================= -->
    <section class="section" id="programme">
      <div class="container">
        <p class="eyebrow">Au programme</p>
        <h2>Un module d'embarquement et dix modules de formation</h2>
        <p class="lead">
          Déplie un module pour voir ce qu'il contient précisément.
        </p>
        <div class="modules">
          {
            modules.map((m) => (
              <details class="module">
                <summary>
                  <span class="module-num">{m.numero}</span>
                  <span class="module-title">{m.titre}</span>
                  <span class="module-chevron" aria-hidden="true" />
                </summary>
                <div class="module-body">
                  <p>{m.intro}</p>
                  <ul>{m.points.map((p) => <li>{p}</li>)}</ul>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= LABORATOIRES ================= -->
    <section class="section section--alt" id="laboratoires">
      <div class="container">
        <p class="eyebrow">Compris dans l'inscription</p>
        <h2>Neuf laboratoires pour muscler le geste</h2>
        <p class="lead">
          Les modules traitent du processus. Les laboratoires traitent de tout
          ce qui l'entoure : le trait, la couleur, le son, les outils.
        </p>
        <div class="grid-3 lab-grid">
          {
            laboratoires.map((l) => (
              <article class="lab-card">
                <h3>{l.titre}</h3>
                <p>{l.texte}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= TÉMOIGNAGES ================= -->
    <section class="section" id="temoignages">
      <div class="container">
        <p class="eyebrow">Elles et ils l'ont suivie</p>
        <h2>Ce qui a changé, concrètement</h2>
        <div class="grid-2 testi-grid">
          {
            temoignages.map((t) => (
              <figure class="card testi-card">
                <blockquote>
                  <p class="testi-before"><span class="testi-tag">Avant</span> {t.avant}</p>
                  <p class="testi-after"><span class="testi-tag testi-tag--after">Après</span> {t.apres}</p>
                </blockquote>
                <figcaption>
                  <strong>{t.nom}</strong>
                  <span>{t.role}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
        <p class="testi-more">
          Ces retours sont extraits du mur de témoignages des anciennes
          promotions.
          <a href={liens.murTemoignages}>Lire les récits complets</a>, avec le
          détail de ce que chacune faisait avant et de ce qu'elle a changé
          ensuite.
        </p>
      </div>
    </section>

    <!-- ================= QUI EST NICOLAS VERDOT ================= -->
    <section class="section section--alt" id="formateur">
      <div class="container">
        <p class="eyebrow">Qui anime l'Académie</p>
        <h2>Qui est Nicolas Verdot&nbsp;?</h2>

        <div class="who">
          <div class="who-portrait">
            <Image
              src={portrait}
              alt="Portrait de Nicolas Verdot, facilitateur graphique et coach certifié"
              widths={[320, 480, 640]}
              sizes="(max-width: 860px) 100vw, 380px"
              class="portrait-img"
              loading="lazy"
            />
            <p class="who-caption">
              {formateur.nom} — {formateur.role}
            </p>
          </div>

          <div class="who-text">
            <p class="who-hook">{formateur.accroche}</p>
            {formateur.bio.map((paragraphe) => <p>{paragraphe}</p>)}
            <a class="who-link" href={liens.linkedin}>
              Son parcours sur LinkedIn
            </a>
          </div>
        </div>

        <ul class="cred-grid">
          {
            credentials.map((c) => (
              <li class="cred-card">
                <h3>{c.titre}</h3>
                <p>{c.texte}</p>
              </li>
            ))
          }
        </ul>

        <div class="clients">
          <p class="clients-intro">
            Les organisations pour lesquelles je facilite ateliers, séminaires
            et réunions de décision. Ce sont mes références de praticien, pas
            des élèves de l'Académie — la méthode enseignée ici est celle que
            j'utilise chez eux.
          </p>
          <ul class="clients-strip">
            {
              clients.map((c) => (
                <li>
                  <img
                    src={c.logo}
                    alt={c.nom}
                    loading="lazy"
                    decoding="async"
                    height="40"
                  />
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- ================= TARIF ================= -->
    <section class="section section--dark" id="tarif">
      <div class="container">
        <div class="pricing-head">
          <p class="eyebrow">Rejoindre la {cohorte.label.toLowerCase()}</p>
          <h2>Deux façons de suivre l'Académie</h2>
          <p class="lead">
            Le contenu est le même dans les deux cas. Ce qui change, c'est le
            temps que je passe avec toi en tête à tête.
          </p>
        </div>

        <div class="plans">
          {
            formules.map((f) => (
              <article
                class:list={['plan', f.miseEnAvant && 'plan--featured']}
              >
                {f.miseEnAvant && f.places && (
                  <p class="plan-flag">{f.places} places seulement</p>
                )}
                <h3>{f.nom}</h3>
                <p class="plan-resume">{f.resume}</p>

                <p class="plan-price">
                  {promo && <s>{fmt(f.prixComptant)} €</s>}
                  <strong>
                    {fmt(prixRemise(f.prixComptant))} €{' '}
                    <em>{offre.mentionTva}</em>
                  </strong>
                  <span>
                    ou {f.nbMensualites} × {fmt(prixRemise(f.prixMensuel))}{' '}
                    €&nbsp;{offre.mentionTva}{sansFrais(f) ? ', sans frais' : ''}
                  </span>
                </p>

                <ul class="plan-list">
                  {f.inclus.map((item) => <li>{item}</li>)}
                </ul>

                {f.enPlus.length > 0 && (
                  <div class="plan-extra">
                    <p class="plan-extra-title">
                      Et deux heures avec moi, en tête à tête
                    </p>
                    {f.enPlus.map((e) => (
                      <div class="plan-extra-item">
                        <h4>{e.titre}</h4>
                        <p>{e.texte}</p>
                      </div>
                    ))}
                    <p class="plan-extra-note">
                      Les deux séances se calent selon tes disponibilités, en
                      visio, à n'importe quel moment de la saison.
                    </p>
                  </div>
                )}

                <a
                  class:list={[
                    'btn',
                    f.miseEnAvant ? 'btn--primary' : 'btn--ghost',
                    'plan-cta',
                  ]}
                  href={lienAchat(f)}
                >
                  Choisir « {f.nom} »
                </a>
              </article>
            ))
          }
        </div>

        <p class="pricing-note">
          Tous les prix sont indiqués {offre.mentionTva}. Paiement sécurisé par
          Stripe via Podia.{' '}
          <a href={`mailto:${offre.emailDevis}?subject=Devis%20Acad%C3%A9mie%20des%20D%C3%A9coinc%C3%A9s%20du%20Crayon%20${cohorte.annees}`}>
            Demande un devis employeur
          </a>{' '}
          si ton entreprise prend la formation en charge. L'Académie n'est en
          revanche pas éligible au CPF.
        </p>
      </div>
    </section>

    <!-- ================= FAQ ================= -->
    <section class="section" id="faq">
      <div class="container">
        <p class="eyebrow">Questions fréquentes</p>
        <h2>Ce qu'on me demande avant de s'inscrire</h2>
        <div class="faq">
          {
            faq.map((item) => (
              <details class="faq-item">
                <summary>
                  {item.question}
                  <span class="module-chevron" aria-hidden="true" />
                </summary>
                <div class="faq-body"><p>{item.reponse}</p></div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= CTA FINAL ================= -->
    <section class="section final-cta">
      <div class="container final-inner">
        <p class="script">On se retrouve en octobre&nbsp;?</p>
        <h2>La prochaine cohorte démarre le {lives[0].libelle.toLowerCase()}</h2>
        <p class="lead">
          Tu peux commencer les modules dès aujourd'hui et arriver au live de
          lancement avec tes premières questions déjà posées.
        </p>
        <a class="btn btn--primary" href={lienPrincipal}>
          Rejoindre la cohorte {cohorte.annees}
        </a>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <p>
        © {new Date().getFullYear()} Nicolas Verdot · Facilitateur graphique ·
        Coach certifié — Décoincés du Crayon · SARL BY Nicolas Verdot
      </p>
      <nav class="footer-links" aria-label="Liens légaux">
        <a href="https://www.decoincesducrayon.com/terms">Conditions générales de vente</a>
        <a href="https://www.decoincesducrayon.com/privacy">Politique de confidentialité</a>
        <a href="https://www.linkedin.com/in/nicolasverdot/">LinkedIn</a>
        <a href={`mailto:${offre.emailDevis}`}>Nous écrire</a>
      </nav>
    </div>
  </footer>

  <!-- Barre d'inscription persistante, révélée après le hero -->
  <div class="sticky-bar" id="sticky-bar" hidden>
    <div class="container sticky-inner">
      <p class="sticky-text">
        <strong>Académie {cohorte.annees}</strong>
        <span>
          À partir de {promo && <s>{fmt(principale.prixComptant)} €</s>}
          {fmt(prixPrincipal)} € {offre.mentionTva} ou{' '}
          {principale.nbMensualites} × {fmt(mensuelPrincipal)} €
        </span>
      </p>
      <a class="btn btn--primary" href={lienPrincipal}>Je m'inscris</a>
    </div>
  </div>
</Layout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding-block: var(--space-20) var(--space-16);
    background:
      radial-gradient(
        90% 120% at 12% 0%,
        var(--color-yellow-soft) 0%,
        transparent 62%
      ),
      var(--color-cream);
    overflow: hidden;
  }

  .hero-inner {
    max-width: 880px;
    margin-inline: auto;
    text-align: center;
  }

  .hero-badge {
    display: inline-block;
    margin: 0 0 var(--space-6);
    padding: var(--space-2) var(--space-5);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .hero h1 {
    margin-bottom: var(--space-6);
  }

  /* Le surligneur doit mordre le bas des lettres, pas leur milieu : trop haut,
     il se lit comme un texte barré — d'autant plus ici, où un vrai prix barré
     apparaît quelques lignes plus bas. */
  .hl {
    background: linear-gradient(
      to bottom,
      transparent 74%,
      var(--color-yellow) 74%,
      var(--color-yellow) 99%,
      transparent 99%
    );
    padding-inline: 0.08em;
  }

  .hero-lead {
    font-size: var(--text-lg);
    color: var(--color-muted);
    max-width: 640px;
    margin: 0 auto var(--space-10);
  }

  .hero-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-10);
  }

  .hero-price {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .hero-proof {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .hero-proof li {
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .hero-proof li::before {
    content: '';
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 50%;
    background: var(--color-clay);
  }

  /* ---------- Chiffres ---------- */
  .numbers {
    background: var(--color-ink-solid);
    color: var(--color-white);
  }

  .numbers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr));
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: center;
  }

  .numbers-grid li {
    margin: 0;
    min-width: 0;
  }

  .numbers-value {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    color: var(--color-yellow);
    line-height: 1.1;
  }

  .numbers-label {
    display: block;
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: rgba(255, 253, 250, 0.78);
  }

  /* ---------- Frictions ---------- */
  .friction-grid {
    margin-top: var(--space-12);
  }

  .friction-card h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-3);
  }

  .friction-card p {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  /* ---------- Compétences ---------- */
  .skill-grid {
    margin-top: var(--space-12);
  }

  .skill-card {
    min-width: 0;
    padding-top: var(--space-5);
    border-top: 3px solid var(--color-yellow);
  }

  .skill-num {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--color-clay);
    margin-bottom: var(--space-2);
  }

  .skill-card h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-3);
  }

  .skill-card p {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  /* ---------- Pour qui ---------- */
  .fit-grid {
    margin-top: var(--space-10);
    align-items: start;
  }

  .fit-card ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fit-card li {
    position: relative;
    padding-left: var(--space-8);
    margin-bottom: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .fit-card li:last-child {
    margin-bottom: 0;
  }

  .fit-card li::before {
    position: absolute;
    left: 0;
    top: 0;
    font-weight: 700;
  }

  .fit-card--yes {
    border-color: var(--color-yellow-ink);
  }

  .fit-card--yes li::before {
    content: '✓';
    color: var(--color-clay);
  }

  .fit-card--no li::before {
    content: '—';
    color: var(--color-muted);
  }

  /* ---------- Plan de vol ---------- */
  .flight-grid {
    margin-top: var(--space-10);
    align-items: start;
  }

  .flight-points {
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .flight-points li {
    padding-left: var(--space-6);
    position: relative;
    margin-bottom: var(--space-3);
    color: rgba(255, 253, 250, 0.82);
    font-size: var(--text-sm);
  }

  .flight-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 10px;
    height: 2px;
    background: var(--color-yellow);
  }

  .calendar {
    background: rgba(255, 253, 250, 0.06);
    border: 1px solid rgba(255, 253, 250, 0.16);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    min-width: 0;
  }

  .calendar h3 {
    font-size: var(--text-base);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    margin-bottom: var(--space-6);
  }

  .calendar-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .calendar-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid rgba(255, 253, 250, 0.12);
    color: var(--color-white);
    font-size: var(--text-sm);
    margin: 0;
  }

  .calendar-list li:last-child {
    border-bottom: none;
  }

  .calendar-note {
    font-family: var(--font-script);
    font-size: var(--text-lg);
    color: var(--color-yellow);
    line-height: 1;
  }

  /* ---------- Modules ---------- */
  .modules {
    margin-top: var(--space-10);
    border-top: 1px solid var(--color-border);
  }

  .module {
    border-bottom: 1px solid var(--color-border);
  }

  .module > summary,
  .faq-item > summary {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-6);
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-navy);
    min-width: 0;
  }

  .module > summary::-webkit-details-marker,
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }

  .module > summary:focus-visible,
  .faq-item > summary:focus-visible {
    outline: 3px solid var(--color-clay);
    outline-offset: 2px;
  }

  .module-num {
    flex: none;
    min-width: 3.5rem;
    font-size: var(--text-sm);
    color: var(--color-clay);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .module-title {
    flex: 1 1 auto;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .module-chevron {
    flex: none;
    margin-left: auto;
    width: 12px;
    height: 12px;
    border-right: 2px solid var(--color-clay);
    border-bottom: 2px solid var(--color-clay);
    transform: rotate(45deg);
    transition: transform var(--duration-hover) var(--ease-out);
  }

  .module[open] .module-chevron,
  .faq-item[open] .module-chevron {
    transform: rotate(-135deg);
  }

  .module-body,
  .faq-body {
    padding: 0 0 var(--space-8);
    max-width: var(--prose-max);
  }

  .module-body p,
  .faq-body p {
    color: var(--color-muted);
  }

  .module-body ul {
    margin: var(--space-4) 0 0;
    padding-left: var(--space-5);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  /* ---------- Laboratoires ---------- */
  .lab-grid {
    margin-top: var(--space-12);
  }

  .lab-card {
    min-width: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-6);
  }

  .lab-card h3 {
    font-size: var(--text-base);
    margin-bottom: var(--space-2);
  }

  .lab-card p {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  /* ---------- Témoignages ---------- */
  .testi-grid {
    margin-top: var(--space-12);
  }

  .testi-card {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .testi-card blockquote {
    margin: 0;
  }

  .testi-card p {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .testi-tag {
    display: inline-block;
    margin-right: var(--space-2);
    padding: 2px var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-border);
    color: var(--color-ink);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .testi-tag--after {
    background: var(--color-yellow);
    color: var(--color-ink-solid);
  }

  .testi-card figcaption {
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    font-size: var(--text-sm);
  }

  .testi-card figcaption span {
    color: var(--color-muted);
  }

  /* ---------- Bandeau de marque ---------- */
  .masthead {
    background: var(--color-cream);
    border-bottom: 1px solid var(--color-border);
  }

  .masthead-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
    min-width: 0;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    min-width: 0;
  }

  .brand-logo {
    width: 190px;
    height: auto;
  }

  /* « Académie » se lit comme la déclinaison du logo, pas comme un mot de
     plus : petite capitale, séparée par un filet. */
  .brand-sub {
    padding-left: var(--space-3);
    border-left: 1px solid var(--color-border);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-muted);
    white-space: nowrap;
  }

  .masthead-cta {
    flex: none;
    padding: var(--space-2) var(--space-5);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
    color: var(--color-ink);
    transition: background-color var(--duration-hover) var(--ease-out),
      color var(--duration-hover) var(--ease-out);
  }

  .masthead-cta:hover {
    background: var(--color-ink);
    color: var(--color-cream);
  }

  .hero-authority {
    margin: var(--space-8) 0 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  /* ---------- Qui est Nicolas Verdot ---------- */
  .who {
    display: grid;
    grid-template-columns: minmax(0, 340px) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: start;
    margin-top: var(--space-10);
  }

  .who-portrait {
    min-width: 0;
  }

  .who-portrait :global(.portrait-img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }

  .who-caption {
    margin: var(--space-4) 0 0;
    font-family: var(--font-script);
    font-size: var(--text-lg);
    color: var(--color-clay);
    line-height: 1.3;
  }

  .who-text {
    min-width: 0;
    color: var(--color-muted);
  }

  .who-hook {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1.25;
    letter-spacing: var(--tracking-tight);
    color: var(--color-navy);
    margin-bottom: var(--space-6);
  }

  .who-link {
    display: inline-block;
    margin-top: var(--space-2);
    font-weight: 700;
    color: var(--color-clay);
    text-decoration: none;
    border-bottom: 2px solid var(--color-yellow);
    padding-bottom: 2px;
  }

  .who-link:hover {
    border-bottom-color: var(--color-clay);
  }

  .cred-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: var(--space-6);
    margin: var(--space-16) 0 0;
    padding: 0;
    list-style: none;
  }

  .cred-card {
    margin: 0;
    min-width: 0;
    padding-top: var(--space-5);
    border-top: 3px solid var(--color-yellow);
  }

  .cred-card h3 {
    font-size: var(--text-base);
    margin-bottom: var(--space-2);
  }

  .cred-card p {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  /* ---------- Références clients ---------- */
  .clients {
    margin-top: var(--space-16);
  }

  .clients-intro {
    max-width: var(--prose-max);
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin-bottom: var(--space-6);
  }

  /* Panneau volontairement clair dans les deux thèmes : les logos clients
     sont fournis en sombre sur fond transparent, les filtrer pour le mode
     sombre les déformerait. */
  .clients-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-8) var(--space-12);
    margin: 0;
    padding: var(--space-8);
    list-style: none;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .clients-strip li {
    margin: 0;
    min-width: 0;
  }

  .clients-strip img {
    height: 38px;
    width: auto;
    max-width: 150px;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.72;
    transition: filter var(--duration-hover) var(--ease-out),
      opacity var(--duration-hover) var(--ease-out);
  }

  .clients-strip img:hover {
    filter: none;
    opacity: 1;
  }

  /* ---------- Renvoi vers le mur de témoignages ---------- */
  .testi-more {
    margin-top: var(--space-10);
    max-width: var(--prose-max);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .testi-more a {
    font-weight: 700;
    color: var(--color-clay);
    text-decoration: none;
    border-bottom: 2px solid var(--color-yellow);
  }

  .testi-more a:hover {
    border-bottom-color: var(--color-clay);
  }

  @media (max-width: 860px) {
    .who {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }
    .who-portrait {
      max-width: 320px;
    }
  }

  /* ---------- Bandeau de remise ---------- */
  .promo-bar {
    background: var(--color-yellow);
    color: var(--color-ink-solid);
  }

  .promo-inner {
    padding-block: var(--space-3);
  }

  .promo-bar p {
    margin: 0;
    font-size: var(--text-sm);
    text-align: center;
    text-wrap: balance;
  }

  /* Sur mobile le bandeau atteignait 123px de haut, soit un sixième d'écran
     avant même le logo. On garde les deux échéances, on coupe le reste. */
  @media (max-width: 640px) {
    .promo-bar p {
      font-size: var(--text-xs);
    }
    .promo-aside {
      display: none;
    }
  }

  /* ---------- Illustrations ---------- */
  .hero-scene {
    max-width: 460px;
    margin: var(--space-12) auto 0;
    color: var(--color-navy);
  }

  .skill-doodle {
    width: 68px;
    margin-bottom: var(--space-4);
    color: var(--color-navy);
  }

  /* ---------- Formules ---------- */
  .pricing-head {
    max-width: 640px;
    margin-inline: auto;
    text-align: center;
  }

  .pricing-head .lead {
    margin-inline: auto;
  }

  .plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: var(--space-8);
    align-items: start;
    margin-top: var(--space-12);
  }

  .plan {
    position: relative;
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: var(--space-10) var(--space-8) var(--space-8);
    border: 1px solid rgba(255, 253, 250, 0.22);
    border-radius: var(--radius-md);
    background: rgba(255, 253, 250, 0.05);
  }

  .plan--featured {
    border-color: var(--color-yellow);
    background: rgba(255, 203, 0, 0.07);
  }

  /* La pastille chevauche la bordure : elle doit se lire comme une étiquette
     agrafée sur la carte, pas comme une ligne de texte de plus. */
  .plan-flag {
    position: absolute;
    top: 0;
    left: var(--space-8);
    transform: translateY(-50%);
    margin: 0;
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--color-yellow);
    color: var(--color-ink-solid);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .plan h3 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
  }

  .plan-resume {
    color: rgba(255, 253, 250, 0.78);
    font-size: var(--text-sm);
    margin-bottom: var(--space-6);
  }

  .plan-price {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-8);
  }

  .plan-price s,
  .hero-price-was,
  .sticky-text s {
    color: rgba(255, 253, 250, 0.55);
    font-size: var(--text-sm);
    text-decoration-thickness: 2px;
  }

  .hero-price-was,
  .sticky-text s {
    color: var(--color-muted);
    margin-right: var(--space-2);
  }

  .plan-price strong {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    color: var(--color-yellow);
    line-height: 1.05;
  }

  .plan-price strong em {
    font-style: normal;
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-wide);
  }

  .plan-price span {
    font-size: var(--text-sm);
    color: rgba(255, 253, 250, 0.72);
  }

  .plan-list {
    margin: 0 0 var(--space-8);
    padding: 0;
    list-style: none;
  }

  .plan-list li {
    position: relative;
    padding-left: var(--space-8);
    margin-bottom: var(--space-3);
    color: rgba(255, 253, 250, 0.88);
    font-size: var(--text-sm);
  }

  .plan-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0;
    color: var(--color-yellow);
    font-weight: 700;
  }

  .plan-extra {
    margin-bottom: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px dashed rgba(255, 203, 0, 0.5);
  }

  .plan-extra-title {
    font-family: var(--font-script);
    font-size: var(--text-xl);
    color: var(--color-yellow);
    margin-bottom: var(--space-5);
  }

  .plan-extra-item {
    margin-bottom: var(--space-5);
  }

  .plan-extra-item h4 {
    font-size: var(--text-base);
    color: var(--color-white);
    margin-bottom: var(--space-1);
  }

  .plan-extra-item p {
    font-size: var(--text-sm);
    color: rgba(255, 253, 250, 0.78);
    margin: 0;
  }

  .plan-extra-note {
    font-size: var(--text-xs);
    color: rgba(255, 253, 250, 0.62);
    margin: 0;
  }

  /* Pousse le bouton en bas quelle que soit la hauteur du contenu, pour que
     les deux cartes alignent leurs actions. */
  .plan-cta {
    margin-top: auto;
    width: 100%;
  }

  .pricing-note {
    margin: var(--space-12) auto 0;
    max-width: 620px;
    text-align: center;
    font-size: var(--text-sm);
    color: rgba(255, 253, 250, 0.7);
  }

  .pricing-note a {
    color: var(--color-yellow);
  }

  /* ---------- FAQ ---------- */
  .faq {
    margin-top: var(--space-10);
    border-top: 1px solid var(--color-border);
    max-width: 860px;
  }

  .faq-item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq-item > summary {
    font-size: var(--text-lg);
    justify-content: space-between;
  }

  /* ---------- CTA final ---------- */
  .final-cta {
    background:
      radial-gradient(
        80% 130% at 50% 100%,
        var(--color-yellow-soft) 0%,
        transparent 60%
      ),
      var(--color-cream);
    text-align: center;
  }

  .final-inner {
    max-width: 680px;
  }

  .final-inner .lead {
    margin-inline: auto;
    margin-bottom: var(--space-8);
  }

  .final-inner .script {
    margin-bottom: var(--space-2);
  }

  /* ---------- Footer ---------- */
  .footer {
    background: var(--color-ink-solid);
    color: rgba(255, 253, 250, 0.72);
    /* Marge basse supplémentaire : la barre d'inscription est en position
       fixed et masquerait les liens légaux pendant sa transition de sortie. */
    padding-block: var(--space-12) var(--space-20);
    font-size: var(--text-sm);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-6);
  }

  .footer p {
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    min-width: 0;
  }

  .footer-links a {
    color: var(--color-white);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 253, 250, 0.3);
    overflow-wrap: anywhere;
  }

  .footer-links a:hover {
    border-bottom-color: var(--color-yellow);
  }

  /* ---------- Barre collante ---------- */
  .sticky-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    box-shadow: 0 -10px 40px rgba(18, 32, 51, 0.12);
    transform: translateY(100%);
    transition: transform var(--duration-standard) var(--ease-out);
  }

  .sticky-bar[data-visible='true'] {
    transform: translateY(0);
  }

  .sticky-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }

  .sticky-text {
    display: flex;
    flex-direction: column;
    margin: 0;
    min-width: 0;
    font-size: var(--text-sm);
  }

  .sticky-text span {
    color: var(--color-muted);
  }

  @media (max-width: 640px) {
    .brand-logo {
      width: 140px;
    }
    /* En dessous de 640px la bande de logos passe à quatre rangées : on
       resserre plutôt que de la laisser occuper un demi-écran. */
    .clients-strip {
      padding: var(--space-6);
      gap: var(--space-6) var(--space-8);
    }
    .clients-strip img {
      height: 30px;
      max-width: 120px;
    }
    .brand-sub {
      display: none;
    }
    .masthead-cta {
      padding: var(--space-2) var(--space-4);
    }
    .sticky-inner {
      justify-content: center;
      text-align: center;
    }
    .sticky-text {
      align-items: center;
    }
    .module > summary {
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-3);
      font-size: var(--text-lg);
    }
    .module-num {
      min-width: 0;
    }
  }
</style>

<script>
  // La barre d'inscription n'apparaît qu'une fois le hero dépassé, et
  // disparaît sur la section tarif où le bouton est déjà présent.
  const bar = document.getElementById('sticky-bar');
  const hero = document.querySelector('.hero');
  // Les zones où un bouton d'inscription est déjà visible : inutile d'y
  // superposer la barre.
  const zonesCta = [
    document.getElementById('tarif'),
    document.querySelector('.final-cta'),
  ].filter(Boolean);

  if (bar && hero) {
    bar.hidden = false;
    let heroPassed = false;
    const ctaVisibles = new Set();

    const sync = () => {
      bar.dataset.visible = String(heroPassed && ctaVisibles.size === 0);
    };

    new IntersectionObserver(
      ([entry]) => {
        heroPassed = !entry.isIntersecting;
        sync();
      },
      { rootMargin: '0px' }
    ).observe(hero);

    const zoneObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) ctaVisibles.add(entry.target);
          else ctaVisibles.delete(entry.target);
        });
        sync();
      },
      { threshold: 0.15 }
    );
    zonesCta.forEach((zone) => zoneObserver.observe(zone));
  }
</script>
