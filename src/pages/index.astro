---
import Layout from '../layouts/Layout.astro';
import {
  chiffres,
  cohorte,
  competences,
  faq,
  formateur,
  frictions,
  laboratoires,
  lives,
  modules,
  offre,
  pourQui,
  temoignages,
} from '../data/academie';

const title =
  'Académie des Décoincés du Crayon — Formation facilitation & facilitation graphique | Cohorte 2026-2027';
const description =
  "Formation en ligne à la facilitation et à la facilitation graphique pour consultants, formateurs et coachs. 11 modules, 9 laboratoires, 7 lives avec Nicolas Verdot. Accès à vie. Cohorte 2026-2027.";

const prixFmt = new Intl.NumberFormat('fr-FR').format(offre.prixComptant);
// « Sans frais » n'est affiché que si l'échelonnement ne coûte réellement rien
// de plus — la mention se met à jour toute seule si un tarif change.
const echelonnementSansFrais =
  offre.prixMensuel * offre.nbMensualites === offre.prixComptant;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: 'Académie des Décoincés du Crayon',
    description:
      "Parcours en ligne à la facilitation et à la facilitation graphique : cadrer une demande, concevoir une session, tenir un groupe et faire atterrir un plan d'action. Destiné aux consultants, formateurs, coachs et facilitateurs.",
    url: 'https://academie.decoincesducrayon.com/',
    inLanguage: 'fr',
    provider: {
      '@type': 'Organization',
      name: 'Décoincés du Crayon',
      url: 'https://www.decoincesducrayon.com',
    },
    offers: {
      '@type': 'Offer',
      price: offre.prixComptant,
      priceCurrency: offre.prixDevise,
      category: 'Paid',
      url: offre.checkoutUrl,
      availability: 'https://schema.org/InStock',
      priceSpecification: {
        '@type': 'PriceSpecification',
        price: offre.prixComptant,
        priceCurrency: offre.prixDevise,
        valueAddedTaxIncluded: true,
      },
    },
    hasCourseInstance: {
      '@type': 'CourseInstance',
      courseMode: 'online',
      courseWorkload: 'PT1H30M',
      startDate: cohorte.debut,
      endDate: cohorte.fin,
      instructor: {
        '@type': 'Person',
        name: formateur.nom,
        jobTitle: formateur.role,
      },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.reponse },
    })),
  },
];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <main id="contenu">
    <!-- ================= HERO ================= -->
    <section class="hero">
      <div class="container hero-inner">
        <p class="hero-badge">{cohorte.label} · Inscriptions ouvertes</p>
        <h1>
          Académie des Décoincés du Crayon : la formation qui relie
          <span class="hl">facilitation</span> et
          <span class="hl">facilitation graphique</span>
        </h1>
        <p class="hero-lead">
          Pour les consultants, formateurs, coachs et facilitateurs qui savent
          déjà donner à voir — ou qui veulent apprendre — mais à qui il manque
          le processus&nbsp;: cadrer une demande, concevoir la session, tenir le
          groupe, et transformer un mur d'idées en décisions qui tiennent.
        </p>

        <div class="hero-cta">
          <a class="btn btn--primary" href={offre.checkoutUrl}>
            Rejoindre la cohorte {cohorte.annees}
          </a>
          <p class="hero-price">
            <strong>{prixFmt} € {offre.mentionTva}</strong> ou
            {offre.nbMensualites} paiements mensuels de {offre.prixMensuel} €
            {offre.mentionTva}
          </p>
        </div>

        <ul class="hero-proof">
          <li>Accès à vie aux contenus</li>
          <li>7 lives en direct avec Nicolas</li>
          <li>Une communauté qui accumule les promotions</li>
        </ul>
      </div>
    </section>

    <!-- ================= CHIFFRES ================= -->
    <section class="section section--tight numbers" aria-label="Le parcours en chiffres">
      <div class="container">
        <ul class="numbers-grid">
          {
            chiffres.map((c) => (
              <li>
                <span class="numbers-value">{c.valeur}</span>
                <span class="numbers-label">{c.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ================= FRICTIONS ================= -->
    <section class="section" id="te-reconnais-tu">
      <div class="container">
        <p class="eyebrow">Te reconnais-tu ?</p>
        <h2>Le dessin ne suffit pas à faire décider un groupe</h2>
        <p class="lead">
          La plupart des personnes qui rejoignent l'Académie ne manquent pas de
          talent. Elles manquent d'un processus. Voici ce qu'elles décrivent
          avant de commencer.
        </p>
        <div class="grid-3 friction-grid">
          {
            frictions.map((f) => (
              <article class="card friction-card">
                <h3>{f.titre}</h3>
                <p>{f.texte}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= COMPÉTENCES ================= -->
    <section class="section section--alt" id="competences">
      <div class="container">
        <p class="eyebrow">Ce que tu sauras faire</p>
        <h2>Six compétences, prises dans l'ordre où tu les utiliseras</h2>
        <p class="lead">
          L'Académie suit le déroulé réel d'une mission, du premier appel du
          client jusqu'à la relecture de ta propre animation.
        </p>
        <div class="grid-3 skill-grid">
          {
            competences.map((c, i) => (
              <article class="skill-card">
                <span class="skill-num">{String(i + 1).padStart(2, '0')}</span>
                <h3>{c.titre}</h3>
                <p>{c.texte}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= POUR QUI ================= -->
    <section class="section" id="pour-qui">
      <div class="container">
        <p class="eyebrow">Public</p>
        <h2>Pour qui c'est fait — et pour qui ça ne l'est pas</h2>
        <div class="grid-2 fit-grid">
          <div class="card fit-card fit-card--yes">
            <h3>C'est pour toi si…</h3>
            <ul>{pourQui.oui.map((t) => <li>{t}</li>)}</ul>
          </div>
          <div class="card fit-card fit-card--no">
            <h3>Passe ton chemin si…</h3>
            <ul>{pourQui.non.map((t) => <li>{t}</li>)}</ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= PLAN DE VOL ================= -->
    <section class="section section--dark" id="plan-de-vol">
      <div class="container">
        <p class="eyebrow">Plan de vol</p>
        <h2>Tu avances à ton rythme, on se retrouve une fois par mois</h2>
        <div class="grid-2 flight-grid">
          <div class="flight-text">
            <p class="lead">
              Tous les modules sont ouverts dès ton inscription : tu n'attends
              pas qu'un contenu se déverrouille. Les lives, eux, rythment la
              saison de septembre à mars et servent à débloquer ce sur quoi tu
              butes réellement.
            </p>
            <ul class="flight-points">
              <li><strong>Accès immédiat</strong> à l'ensemble des modules et des laboratoires.</li>
              <li><strong>Mises à jour incluses</strong> à vie, y compris les contenus ajoutés après ta cohorte.</li>
              <li><strong>Replays systématiques</strong> si tu ne peux pas assister à un live.</li>
            </ul>
          </div>
          <div class="calendar">
            <h3>Les 7 lives · 18h30, heure de Paris</h3>
            <ol class="calendar-list">
              {
                lives.map((l) => (
                  <li>
                    <time datetime={l.date}>{l.libelle}</time>
                    {l.note && <span class="calendar-note">{l.note}</span>}
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= MODULES ================= -->
    <section class="section" id="programme">
      <div class="container">
        <p class="eyebrow">Au programme</p>
        <h2>Un module d'embarquement et dix modules de formation</h2>
        <p class="lead">
          Déplie un module pour voir ce qu'il contient précisément.
        </p>
        <div class="modules">
          {
            modules.map((m) => (
              <details class="module">
                <summary>
                  <span class="module-num">{m.numero}</span>
                  <span class="module-title">{m.titre}</span>
                  <span class="module-chevron" aria-hidden="true" />
                </summary>
                <div class="module-body">
                  <p>{m.intro}</p>
                  <ul>{m.points.map((p) => <li>{p}</li>)}</ul>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= LABORATOIRES ================= -->
    <section class="section section--alt" id="laboratoires">
      <div class="container">
        <p class="eyebrow">Compris dans l'inscription</p>
        <h2>Neuf laboratoires pour muscler le geste</h2>
        <p class="lead">
          Les modules traitent du processus. Les laboratoires traitent de tout
          ce qui l'entoure : le trait, la couleur, le son, les outils.
        </p>
        <div class="grid-3 lab-grid">
          {
            laboratoires.map((l) => (
              <article class="lab-card">
                <h3>{l.titre}</h3>
                <p>{l.texte}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= TÉMOIGNAGES ================= -->
    <section class="section" id="temoignages">
      <div class="container">
        <p class="eyebrow">Elles et ils l'ont suivie</p>
        <h2>Ce qui a changé, concrètement</h2>
        <div class="grid-2 testi-grid">
          {
            temoignages.map((t) => (
              <figure class="card testi-card">
                <blockquote>
                  <p class="testi-before"><span class="testi-tag">Avant</span> {t.avant}</p>
                  <p class="testi-after"><span class="testi-tag testi-tag--after">Après</span> {t.apres}</p>
                </blockquote>
                <figcaption>
                  <strong>{t.nom}</strong>
                  <span>{t.role}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= FORMATEUR ================= -->
    <section class="section section--alt" id="formateur">
      <div class="container">
        <p class="eyebrow">Qui anime</p>
        <h2>{formateur.nom}, {formateur.role}</h2>
        <div class="bio">
          {formateur.bio.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <!-- ================= TARIF ================= -->
    <section class="section section--dark" id="tarif">
      <div class="container">
        <div class="pricing">
          <p class="eyebrow">Rejoindre la {cohorte.label.toLowerCase()}</p>
          <h2>Une inscription, un accès à vie</h2>
          <p class="pricing-amount">
            <strong>{prixFmt} € <em>{offre.mentionTva}</em></strong>
            <span>
              ou {offre.nbMensualites} × {offre.prixMensuel} €
              {offre.mentionTva}{echelonnementSansFrais ? ', sans frais' : ''}
            </span>
          </p>
          <ul class="pricing-list">
            <li>11 modules de formation, disponibles immédiatement</li>
            <li>9 laboratoires avancés et les cahiers d'exercices</li>
            <li>7 lives avec Nicolas entre septembre 2026 et mars 2027</li>
            <li>Les replays et toutes les mises à jour futures, à vie</li>
            <li>Le groupe privé et l'accès aux lives des cohortes suivantes</li>
          </ul>
          <div class="pricing-cta">
            <a class="btn btn--primary" href={offre.checkoutUrl}>
              Je m'inscris à l'Académie
            </a>
            <a class="btn btn--ghost" href={`mailto:${offre.emailDevis}?subject=Devis%20Acad%C3%A9mie%20des%20D%C3%A9coinc%C3%A9s%20du%20Crayon%20${cohorte.annees}`}>
              Demander un devis employeur
            </a>
          </div>
          <p class="pricing-note">
            Tous les prix sont indiqués {offre.mentionTva}. Paiement sécurisé
            par Stripe via Podia. Ton entreprise peut prendre l'Académie en
            charge : demande un devis et fais-le valider en interne.
            L'Académie n'est en revanche pas éligible au CPF.
          </p>
        </div>
      </div>
    </section>

    <!-- ================= FAQ ================= -->
    <section class="section" id="faq">
      <div class="container">
        <p class="eyebrow">Questions fréquentes</p>
        <h2>Ce qu'on me demande avant de s'inscrire</h2>
        <div class="faq">
          {
            faq.map((item) => (
              <details class="faq-item">
                <summary>
                  {item.question}
                  <span class="module-chevron" aria-hidden="true" />
                </summary>
                <div class="faq-body"><p>{item.reponse}</p></div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= CTA FINAL ================= -->
    <section class="section final-cta">
      <div class="container final-inner">
        <p class="script">On se retrouve en septembre&nbsp;?</p>
        <h2>La prochaine cohorte démarre le {lives[0].libelle.toLowerCase()}</h2>
        <p class="lead">
          Tu peux commencer les modules dès aujourd'hui et arriver au live de
          lancement avec tes premières questions déjà posées.
        </p>
        <a class="btn btn--primary" href={offre.checkoutUrl}>
          Rejoindre la cohorte {cohorte.annees}
        </a>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <p>
        © {new Date().getFullYear()} Nicolas Verdot · Facilitateur graphique ·
        Coach certifié — Décoincés du Crayon · SARL BY Nicolas Verdot
      </p>
      <nav class="footer-links" aria-label="Liens légaux">
        <a href="https://www.decoincesducrayon.com/terms">Conditions générales de vente</a>
        <a href="https://www.decoincesducrayon.com/privacy">Politique de confidentialité</a>
        <a href="https://www.linkedin.com/in/nicolasverdot/">LinkedIn</a>
        <a href={`mailto:${offre.emailDevis}`}>Nous écrire</a>
      </nav>
    </div>
  </footer>

  <!-- Barre d'inscription persistante, révélée après le hero -->
  <div class="sticky-bar" id="sticky-bar" hidden>
    <div class="container sticky-inner">
      <p class="sticky-text">
        <strong>Académie {cohorte.annees}</strong>
        <span>
          {prixFmt} € {offre.mentionTva} ou {offre.nbMensualites} ×
          {offre.prixMensuel} € {offre.mentionTva}
        </span>
      </p>
      <a class="btn btn--primary" href={offre.checkoutUrl}>Je m'inscris</a>
    </div>
  </div>
</Layout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding-block: var(--space-20) var(--space-16);
    background:
      radial-gradient(
        90% 120% at 12% 0%,
        var(--color-yellow-soft) 0%,
        transparent 62%
      ),
      var(--color-cream);
    overflow: hidden;
  }

  .hero-inner {
    max-width: 880px;
    margin-inline: auto;
    text-align: center;
  }

  .hero-badge {
    display: inline-block;
    margin: 0 0 var(--space-6);
    padding: var(--space-2) var(--space-5);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .hero h1 {
    margin-bottom: var(--space-6);
  }

  .hl {
    background: linear-gradient(
      to bottom,
      transparent 62%,
      var(--color-yellow) 62%,
      var(--color-yellow) 92%,
      transparent 92%
    );
    padding-inline: 0.08em;
  }

  .hero-lead {
    font-size: var(--text-lg);
    color: var(--color-muted);
    max-width: 640px;
    margin: 0 auto var(--space-10);
  }

  .hero-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-10);
  }

  .hero-price {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .hero-proof {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .hero-proof li {
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .hero-proof li::before {
    content: '';
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 50%;
    background: var(--color-clay);
  }

  /* ---------- Chiffres ---------- */
  .numbers {
    background: var(--color-ink-solid);
    color: var(--color-white);
  }

  .numbers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr));
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: center;
  }

  .numbers-grid li {
    margin: 0;
    min-width: 0;
  }

  .numbers-value {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    color: var(--color-yellow);
    line-height: 1.1;
  }

  .numbers-label {
    display: block;
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: rgba(255, 253, 250, 0.78);
  }

  /* ---------- Frictions ---------- */
  .friction-grid {
    margin-top: var(--space-12);
  }

  .friction-card h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-3);
  }

  .friction-card p {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  /* ---------- Compétences ---------- */
  .skill-grid {
    margin-top: var(--space-12);
  }

  .skill-card {
    min-width: 0;
    padding-top: var(--space-5);
    border-top: 3px solid var(--color-yellow);
  }

  .skill-num {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--color-clay);
    margin-bottom: var(--space-2);
  }

  .skill-card h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-3);
  }

  .skill-card p {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  /* ---------- Pour qui ---------- */
  .fit-grid {
    margin-top: var(--space-10);
    align-items: start;
  }

  .fit-card ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fit-card li {
    position: relative;
    padding-left: var(--space-8);
    margin-bottom: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .fit-card li:last-child {
    margin-bottom: 0;
  }

  .fit-card li::before {
    position: absolute;
    left: 0;
    top: 0;
    font-weight: 700;
  }

  .fit-card--yes {
    border-color: var(--color-yellow-ink);
  }

  .fit-card--yes li::before {
    content: '✓';
    color: var(--color-clay);
  }

  .fit-card--no li::before {
    content: '—';
    color: var(--color-muted);
  }

  /* ---------- Plan de vol ---------- */
  .flight-grid {
    margin-top: var(--space-10);
    align-items: start;
  }

  .flight-points {
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .flight-points li {
    padding-left: var(--space-6);
    position: relative;
    margin-bottom: var(--space-3);
    color: rgba(255, 253, 250, 0.82);
    font-size: var(--text-sm);
  }

  .flight-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 10px;
    height: 2px;
    background: var(--color-yellow);
  }

  .calendar {
    background: rgba(255, 253, 250, 0.06);
    border: 1px solid rgba(255, 253, 250, 0.16);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    min-width: 0;
  }

  .calendar h3 {
    font-size: var(--text-base);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    margin-bottom: var(--space-6);
  }

  .calendar-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .calendar-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid rgba(255, 253, 250, 0.12);
    color: var(--color-white);
    font-size: var(--text-sm);
    margin: 0;
  }

  .calendar-list li:last-child {
    border-bottom: none;
  }

  .calendar-note {
    font-family: var(--font-script);
    font-size: var(--text-lg);
    color: var(--color-yellow);
    line-height: 1;
  }

  /* ---------- Modules ---------- */
  .modules {
    margin-top: var(--space-10);
    border-top: 1px solid var(--color-border);
  }

  .module {
    border-bottom: 1px solid var(--color-border);
  }

  .module > summary,
  .faq-item > summary {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-6);
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-navy);
    min-width: 0;
  }

  .module > summary::-webkit-details-marker,
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }

  .module > summary:focus-visible,
  .faq-item > summary:focus-visible {
    outline: 3px solid var(--color-clay);
    outline-offset: 2px;
  }

  .module-num {
    flex: none;
    min-width: 3.5rem;
    font-size: var(--text-sm);
    color: var(--color-clay);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .module-title {
    flex: 1 1 auto;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .module-chevron {
