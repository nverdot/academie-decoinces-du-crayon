# Copier ce fichier en .env et renseigner les valeurs.
# .env est ignoré par git : les identifiants ne partent jamais sur le dépôt.

# Hôte FTP (sans ftp:// ni chemin), ex. ftp.decoincesducrayon.com
FTP_SERVER=
FTP_USERNAME=
FTP_PASSWORD=
# Dossier cible du sous-domaine sur le serveur, terminé par un /
# ex. /academie.decoincesducrayon.com/
FTP_SERVER_DIR=
